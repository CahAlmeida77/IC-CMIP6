# CÓDIGO PARA PROCESSAMENTO DE DADOS DE PRECIPITAÇÃO ACUMULADA, IC E LIMITES INFERIOR E SUPERIOR COM QUANTIS A PARTIR DA PRIMEIRA CORREÇÃO
# REALIZADA NO CÓDIGO DO ENSEMBLE

import os
import netCDF4 as nc
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
from datetime import datetime

# =============================================
# CONFIGURAÇÕES
# =============================================
pasta_netcdf = r'C:\ic\dados\ssp245'         # Pasta com arquivos NetCDF
pasta_saida = r'C:\ic\resultados_quantis245'     # Pasta de saída
arquivo_estacoes = r'C:\ic\script\estacoes.csv'       # Arquivo CSV com estações

# Criar pasta de saída se não existir
os.makedirs(pasta_saida, exist_ok=True)

# =============================================
# CARREGAR ESTAÇÕES METEOROLÓGICAS
# =============================================
try:
    df_estacoes = pd.read_csv(arquivo_estacoes)
    estacoes = [{
        'codigo': row['codigo'],
        'lat': row['lat'],
        'lon': row['long']
    } for _, row in df_estacoes.iterrows()]
    print(f"✅ Carregadas {len(estacoes)} estações do arquivo {arquivo_estacoes}")
except Exception as e:
    print(f"❌ Erro ao carregar estações: {str(e)}")
    exit()

# =============================================
# FUNÇÃO PARA PROCESSAR UM ARQUIVO NETCDF
# =============================================
def processar_arquivo(arquivo_nc, pasta_netcdf, estacoes):
    caminho_arquivo = os.path.join(pasta_netcdf, arquivo_nc)
    dados_nc = nc.Dataset(caminho_arquivo)
    
    # Extrair variáveis
    tempo = dados_nc.variables['time'][:]
    latitudes = dados_nc.variables['lat'][:]
    longitudes = dados_nc.variables['lon'][:]
    precipitacao = dados_nc.variables['pr'][:]
    
    # Converter tempo para datas
    data_referencia = pd.to_datetime('2000-01-01')
    datas = data_referencia + pd.to_timedelta(tempo, unit='D')
    
    # Estrutura para armazenar resultados
    resultados = {'Data': datas}
    
    # Processar cada estação
    for estacao in estacoes:
        lat_idx = (np.abs(latitudes - estacao['lat'])).argmin()
        lon_idx = (np.abs(longitudes - estacao['lon'])).argmin()
        resultados[estacao['codigo']] = precipitacao[:, lat_idx, lon_idx]
    
    dados_nc.close()
    return pd.DataFrame(resultados), os.path.splitext(arquivo_nc)[0]

# =============================================
# PROCESSAMENTO PRINCIPAL
# =============================================
arquivos_nc = [f for f in os.listdir(pasta_netcdf) if f.endswith('.nc')]
modelos = {}

print("\n⏳ Processando arquivos NetCDF...")
for i, arquivo in enumerate(arquivos_nc, 1):
    try:
        print(f"\n📁 Arquivo {i}/{len(arquivos_nc)}: {arquivo}")
        df, nome_modelo = processar_arquivo(arquivo, pasta_netcdf, estacoes)
        modelos[nome_modelo] = df
        print(f"✅ Processado com sucesso!")
    except Exception as e:
        print(f"❌ Erro ao processar {arquivo}: {str(e)}")

# =============================================
# GERAR RESULTADOS COM QUANTIS E IC
# =============================================
print("\n📊 Gerando resultados com quantis e intervalo de confiança...")
os.makedirs(os.path.join(pasta_saida, 'graficos_quantis'), exist_ok=True)

for estacao in estacoes:
    codigo = estacao['codigo']
    print(f"\n🔍 Processando estação {codigo}...")
    
    # Combinar dados de todos os modelos
    df_estacao = pd.DataFrame({'Data': modelos[next(iter(modelos))]['Data']})
    
    for nome_modelo, df in modelos.items():
        df_estacao[nome_modelo] = df[codigo]
    
    # Calcular acumulado para cada modelo
    for nome_modelo in modelos.keys():
        df_estacao[f'{nome_modelo}_acumulado'] = df_estacao[nome_modelo].cumsum()
    
    # Calcular quantis (10%, 50%, 90%) para cada dia
    colunas_acumulado = [f'{m}_acumulado' for m in modelos.keys()]
    df_estacao['Q10'] = df_estacao[colunas_acumulado].quantile(0.1, axis=1)
    df_estacao['Q50'] = df_estacao[colunas_acumulado].quantile(0.5, axis=1)
    df_estacao['Q90'] = df_estacao[colunas_acumulado].quantile(0.9, axis=1)
    
    # Calcular média e desvio padrão para o IC 95%
    df_estacao['Media'] = df_estacao[colunas_acumulado].mean(axis=1)
    df_estacao['Desvio_Padrao'] = df_estacao[colunas_acumulado].std(axis=1)
    
    # Calcular intervalo de confiança 95%
    n_modelos = len(modelos)
    z_score = 1.96
    df_estacao['IC_inferior'] = df_estacao['Media'] - z_score * (df_estacao['Desvio_Padrao'] / np.sqrt(n_modelos))
    df_estacao['IC_superior'] = df_estacao['Media'] + z_score * (df_estacao['Desvio_Padrao'] / np.sqrt(n_modelos))
    
    # Salvar CSV
    caminho_csv = os.path.join(pasta_saida, f'estacao_{codigo}_quantis_acumulado.csv')
    df_estacao.to_csv(caminho_csv, index=False)
    print(f"💾 Dados salvos em {caminho_csv}")
    
    # Gerar gráfico
    plt.figure(figsize=(14, 8))
    
    # Configurações do gráfico
    plt.title(f'Precipitação Acumulada com Quantis - Estação {codigo}', fontsize=14, pad=20)
    
    # Plotar média (Q50)
    plt.plot(df_estacao['Data'], df_estacao['Q50'], 
             label='Média (Q50)', color='blue', linewidth=2)
    
    # Plotar área entre Q10 e Q90
    plt.fill_between(df_estacao['Data'], 
                    df_estacao['Q10'], 
                    df_estacao['Q90'],
                    color='lightblue', alpha=0.3, label='Intervalo Q10-Q90')
    
    # Plotar intervalo de confiança 95%
    plt.fill_between(df_estacao['Data'], 
                    df_estacao['IC_inferior'], 
                    df_estacao['IC_superior'],
                    color='blue', alpha=0.2, label='IC 95%')
    
    # Configurações adicionais
    plt.xlabel('Data', fontsize=12)
    plt.ylabel('Precipitação Acumulada (mm)', fontsize=12)
    plt.grid(True, linestyle='--', alpha=0.7)
    plt.legend(fontsize=10, loc='upper left')
    
    # Ajustar layout e salvar
    plt.tight_layout()
    caminho_grafico = os.path.join(pasta_saida, 'graficos_quantis', f'quantis_acumulado_{codigo}.png')
    plt.savefig(caminho_grafico, bbox_inches='tight', dpi=300)
    plt.close()
    print(f"🖼️ Gráfico com quantis salvo em {caminho_grafico}")

# =============================================
# GERAR ESTATÍSTICAS CONSOLIDADAS
# =============================================
print("\n📈 Gerando estatísticas consolidadas...")
df_stats = pd.DataFrame()

for codigo in [e['codigo'] for e in estacoes]:
    caminho_csv = os.path.join(pasta_saida, f'estacao_{codigo}_quantis_acumulado.csv')
    df = pd.read_csv(caminho_csv)
    
    # Estatísticas por modelo
    for modelo in modelos.keys():
        df_stats.loc[codigo, f'{modelo}_acumulado_final'] = df[f'{modelo}_acumulado'].iloc[-1]
    
    # Estatísticas dos quantis
    df_stats.loc[codigo, 'Q10_final'] = df['Q10'].iloc[-1]
    df_stats.loc[codigo, 'Q50_final'] = df['Q50'].iloc[-1]
    df_stats.loc[codigo, 'Q90_final'] = df['Q90'].iloc[-1]
    df_stats.loc[codigo, 'Media_final'] = df['Media'].iloc[-1]
    df_stats.loc[codigo, 'IC_inferior_final'] = df['IC_inferior'].iloc[-1]
    df_stats.loc[codigo, 'IC_superior_final'] = df['IC_superior'].iloc[-1]

caminho_stats = os.path.join(pasta_saida, 'estatisticas_quantis_consolidadas.csv')
df_stats.to_csv(caminho_stats)
print(f"📊 Estatísticas com quantis salvas em {caminho_stats}")

print("\n🎉 Processamento concluído! Resultados disponíveis em:", pasta_saida)
